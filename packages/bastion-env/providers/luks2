#!/usr/bin/env bash
# BastionOS dual-env STORAGE PROVIDER: luks2
# Two+ LUKS2 containers with IDENTICAL Argon2id parameters.
#
# Provides ISOLATION + CONFIDENTIALITY, *not* deniability of existence: the container
# files are enumerable and carry LUKS2 headers (the forensic test proves this). Use the
# `shufflecake` provider when deniability is the requirement. See docs/03-phase2-dual-env.md.
#
# Contract (password, when needed, on stdin):
#   init | add | try-unlock | verify-active <src> | mount <mapper> | unmount <mapper>
set -euo pipefail

: "${BASTION_USER:?BASTION_USER not set}"
STORE="${BASTION_STORE:-/var/lib/bastion-env/$BASTION_USER}"
HOME_DIR="${BASTION_HOME:-/home/$BASTION_USER}"
SIZE="${BASTION_ENV_SIZE:-2G}"

# Fixed params => every container is equally expensive to try (constant-time auth) and
# headers are indistinguishable in difficulty across machines.
LUKS_ARGS=(--type luks2 --pbkdf argon2id --pbkdf-memory 1048576
           --pbkdf-force-iterations 4 --cipher aes-xts-plain64
           --key-size 512 --hash sha512 --batch-mode)

containers() { ls -1 "$STORE"/env.* 2>/dev/null | sort -V || true; }
next_index() { local n=0; while [ -e "$STORE/env.$n" ]; do n=$((n + 1)); done; echo "$n"; }
uid_of() { id -u "$BASTION_USER"; }
gid_of() { id -g "$BASTION_USER"; }

_format() { # <src> ; password on stdin
	local src="$1" pw m mp
	pw="$(cat)"
	printf '%s' "$pw" | cryptsetup luksFormat "${LUKS_ARGS[@]}" "$src" -
	m="bastion_fmt_$$"
	printf '%s' "$pw" | cryptsetup open --type luks2 "$src" "$m" -
	mkfs.ext4 -q -m0 "/dev/mapper/$m"
	mp="$(mktemp -d)"
	mount "/dev/mapper/$m" "$mp"
	cp -aT /etc/skel "$mp" 2>/dev/null || true
	chown -R "$(uid_of)":"$(gid_of)" "$mp"
	chmod 0700 "$mp"
	umount "$mp"; rmdir "$mp"
	cryptsetup close "$m"
}

cmd="${1:-}"; shift || true
case "$cmd" in
init)
	[ -z "$(containers)" ] || { echo "already initialized" >&2; exit 1; }
	mkdir -p "$STORE"; chmod 0700 "$STORE"
	truncate -s "$SIZE" "$STORE/env.0"
	_format "$STORE/env.0"
	;;
add)
	[ -n "$(containers)" ] || { echo "run init first" >&2; exit 1; }
	i="$(next_index)"
	truncate -s "$SIZE" "$STORE/env.$i"
	_format "$STORE/env.$i"
	;;
try-unlock) # password on stdin -> "ENVID MAPPER SRC" ; ALWAYS runs the KDF for every env
	pw="$(cat)"
	match_env=""; match_map=""; match_src=""
	for c in $(containers); do
		envid="$(basename "$c")"
		m="bastion_home_${envid}_$$"
		if printf '%s' "$pw" | cryptsetup open --type luks2 "$c" "$m" - 2>/dev/null; then
			if [ -z "$match_map" ]; then
				match_env="$envid"; match_map="$m"; match_src="$c"
			else
				cryptsetup close "$m" 2>/dev/null || true   # distinct pw per env; keep first match only
			fi
		fi
	done
	[ -n "$match_map" ] || exit 1
	printf '%s %s %s\n' "$match_env" "$match_map" "$match_src"
	;;
verify-active) # <src> ; password on stdin ; single KDF, opens/maps nothing
	src="$1"; pw="$(cat)"
	printf '%s' "$pw" | cryptsetup open --test-passphrase --type luks2 "$src" - 2>/dev/null
	;;
mount) # <mapper>
	m="$1"
	mount -o noatime,nosuid,nodev "/dev/mapper/$m" "$HOME_DIR"
	chown "$(uid_of)":"$(gid_of)" "$HOME_DIR"
	;;
unmount) # <mapper>
	m="$1"
	mountpoint -q "$HOME_DIR" && umount "$HOME_DIR" || true
	[ -e "/dev/mapper/$m" ] && cryptsetup close "$m" || true
	;;
*)
	echo "usage: $0 {init|add|try-unlock|verify-active <src>|mount <mapper>|unmount <mapper>}" >&2
	exit 2
	;;
esac
