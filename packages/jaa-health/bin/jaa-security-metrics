#!/usr/bin/env bash
# jaa-security-metrics — emit jaaOS security posture as Prometheus text, for the
# node_exporter textfile collector. Run from a short systemd timer (see docs/06). Writes
# atomically (temp + rename) so node_exporter never reads a half-written file.
#
# set -uo pipefail (NOT -e): a missing probe must degrade to a 0/omitted metric, never abort
# the whole collector (same posture as jaa-env-pam).
#
# DENIABILITY: every metric here is about the ACTIVE system (auditd, AIDE, AppArmor, Falco).
# None counts or names environments/homes. Do not add anything that does.
set -uo pipefail

OUT="${JAA_SECMETRICS_OUT:-/var/lib/prometheus/node-exporter/jaa-security.prom}"
AIDE_LOG_DIR="${JAA_AIDE_LOG_DIR:-/var/log/aide}"
AIDE_DB="${JAA_AIDE_DB:-/var/lib/aide/aide.db}"
FALCO_LOG="${JAA_FALCO_LOG:-/var/log/falco/events.txt}"

have() { command -v "$1" >/dev/null 2>&1; }
tmp="$(mktemp "${OUT}.XXXXXX" 2>/dev/null || mktemp)"
trap 'rm -f "$tmp"' EXIT
emit() { printf '%s\n' "$1" >> "$tmp"; }

emit "# jaaOS security metrics (jaa-security-metrics)."

# --- auditd up ---
emit "# HELP jaa_auditd_up 1 if the audit daemon is active."
emit "# TYPE jaa_auditd_up gauge"
if have systemctl; then
	[ "$(systemctl is-active auditd 2>/dev/null)" = active ] && emit "jaa_auditd_up 1" || emit "jaa_auditd_up 0"
else
	pgrep -x auditd >/dev/null 2>&1 && emit "jaa_auditd_up 1" || emit "jaa_auditd_up 0"
fi

# --- AIDE: last run + change count (parse newest report under AIDE_LOG_DIR) ---
emit "# HELP jaa_aide_changes_total Added+changed+removed entries in the last AIDE check."
emit "# TYPE jaa_aide_changes_total gauge"
emit "# HELP jaa_aide_last_run_timestamp_seconds Unix time of the last AIDE check (omitted if unknown)."
emit "# TYPE jaa_aide_last_run_timestamp_seconds gauge"
report=""
if [ -d "$AIDE_LOG_DIR" ]; then
	report=$(ls -1t "$AIDE_LOG_DIR"/* 2>/dev/null | head -1)
fi
if [ -n "$report" ] && [ -f "$report" ]; then
	added=$(grep -aiE '^\s*(Added|Added entries)[: ]' "$report" | grep -oE '[0-9]+' | head -1)
	removed=$(grep -aiE '^\s*(Removed|Removed entries)[: ]' "$report" | grep -oE '[0-9]+' | head -1)
	changed=$(grep -aiE '^\s*(Changed|Changed entries)[: ]' "$report" | grep -oE '[0-9]+' | head -1)
	total=$(( ${added:-0} + ${removed:-0} + ${changed:-0} ))
	emit "jaa_aide_changes_total ${total}"
	ts=$(stat -c %Y "$report" 2>/dev/null || echo "")
	[ -n "$ts" ] && emit "jaa_aide_last_run_timestamp_seconds ${ts}"
elif [ -f "$AIDE_DB" ]; then
	# No report, but a DB exists — report 0 changes, last run = DB mtime.
	emit "jaa_aide_changes_total 0"
	ts=$(stat -c %Y "$AIDE_DB" 2>/dev/null || echo "")
	[ -n "$ts" ] && emit "jaa_aide_last_run_timestamp_seconds ${ts}"
else
	emit "jaa_aide_changes_total 0"
fi

# --- AppArmor profiles by mode ---
emit "# HELP jaa_apparmor_profiles Loaded AppArmor profiles by enforcement mode."
emit "# TYPE jaa_apparmor_profiles gauge"
if have aa-status; then
	enf=$(aa-status --enforced 2>/dev/null || echo 0)
	cpl=$(aa-status --complaining 2>/dev/null || echo 0)
	[[ "$enf" =~ ^[0-9]+$ ]] || enf=0
	[[ "$cpl" =~ ^[0-9]+$ ]] || cpl=0
	emit "jaa_apparmor_profiles{mode=\"enforce\"} ${enf}"
	emit "jaa_apparmor_profiles{mode=\"complain\"} ${cpl}"
fi

# --- Falco event count (lines in the Falco file output) ---
emit "# HELP jaa_falco_events_total Total Falco events written to the output file."
emit "# TYPE jaa_falco_events_total counter"
if [ -f "$FALCO_LOG" ]; then
	n=$(wc -l < "$FALCO_LOG" 2>/dev/null | tr -d ' '); emit "jaa_falco_events_total ${n:-0}"
else
	emit "jaa_falco_events_total 0"
fi

# --- collector heartbeat ---
emit "# HELP jaa_security_metrics_last_run_timestamp_seconds Unix time this collector last ran."
emit "# TYPE jaa_security_metrics_last_run_timestamp_seconds gauge"
emit "jaa_security_metrics_last_run_timestamp_seconds $(date +%s)"

mkdir -p "$(dirname "$OUT")" 2>/dev/null
mv "$tmp" "$OUT" && trap - EXIT
