#!/usr/bin/env bash
# jaa-scan — authorized-testing-ONLY VAPT orchestrator (prototype / behavioural spec).
# Rust port target: crates/jaa-scan (ADR 0002).
#
# WHAT THIS IS: a scope-ENFORCING, authorization-GATED, AUDITED wrapper that runs standard
# assessment tools inside rootless, capability-dropped Podman containers. The guardrails are the
# product — the point of `jaa-scan` over running nmap by hand is that it REFUSES to touch
# anything not written into a signed-off engagement file.
#
# WHAT THIS IS NOT: it ships no exploits, no DoS/stress, no detection-evasion, and no
# mass-targeting. Default profiles are non-destructive reconnaissance / vulnerability
# ASSESSMENT (discovery, TLS hygiene, web detection). Active exploitation is out of scope for
# the default profiles and is intentionally not a push-button here (see docs/07-phase6-vapt.md).
#
# set -uo pipefail (NOT -e): scope/engagement checks use lots of grep/test whose non-zero exit
# is normal control flow. Every refusal goes through die(); nothing runs until all gates pass.
set -uo pipefail

CONF="${JAA_SCAN_PREFIX:-}/etc/jaa/scan/scan.conf"
AUDIT_DEFAULT="${JAA_SCAN_PREFIX:-}/var/log/jaa-scan/audit.log"
RESULTS_DEFAULT="${JAA_SCAN_PREFIX:-}/var/lib/jaa-scan/results"
ENGAGEMENT="${JAA_SCAN_ENGAGEMENT:-./engagement.conf}"
DRYRUN="${JAA_SCAN_DRYRUN:-0}"            # 1 = resolve + audit, but never launch a container
IMAGE_DEFAULT="localhost/jaaos/vapt:pinned"

die()  { echo "REFUSED: $*" >&2; exit 1; }
warn() { echo "WARN: $*" >&2; }
note() { echo "   $*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }

# Strip an inline "  # comment" (comment must be whitespace-separated, so a value may contain
# '#') and trim surrounding whitespace. A value that is only a comment becomes empty.
strip_val() { sed 's/[[:space:]][[:space:]]*#.*$//; s/^[[:space:]]*//; s/[[:space:]]*$//'; }

# ---- config (optional; engagement file is the real authority) ----
conf_get() { [ -f "$CONF" ] && sed -n "s/^$1=//p" "$CONF" | head -1 | strip_val || true; }
IMAGE="$(conf_get IMAGE)";           IMAGE="${IMAGE:-$IMAGE_DEFAULT}"
AUDIT="$(conf_get AUDIT_LOG)";       AUDIT="${AUDIT:-$AUDIT_DEFAULT}"
RESULTS="$(conf_get RESULTS_DIR)";   RESULTS="${RESULTS:-$RESULTS_DEFAULT}"

# ---- engagement parsing (PARSED, never sourced — the file is data, not code) ----
eng_get()  { sed -n "s/^$1=//p" "$ENGAGEMENT" 2>/dev/null | head -1 | strip_val; }
eng_list() { eng_get "$1"; }   # arrays are space-separated scalars; word-split at call site

require_engagement() {
	[ -f "$ENGAGEMENT" ] || die "no engagement file ($ENGAGEMENT). Create one: jaa-scan engagement init <name>"
	local ref scope
	ref="$(eng_get AUTHORIZATION_REF)"
	[ -n "$ref" ] || die "engagement has no AUTHORIZATION_REF — authorization is mandatory"
	scope="$(eng_get SCOPE_CIDRS) $(eng_get SCOPE_HOSTS) $(eng_get SCOPE_DOMAINS)"
	[ -n "${scope// /}" ] || die "engagement declares no scope (SCOPE_CIDRS/SCOPE_HOSTS/SCOPE_DOMAINS)"
}

check_window() {
	local s e now; s="$(eng_get WINDOW_START)"; e="$(eng_get WINDOW_END)"
	have date || return 0
	now=$(date -u +%s)
	if [ -n "$s" ]; then
		local si; si=$(date -u -d "$s" +%s 2>/dev/null) || die "bad WINDOW_START: $s"
		[ "$now" -ge "$si" ] || die "engagement window has not started ($s)"
	fi
	if [ -n "$e" ]; then
		local ei; ei=$(date -u -d "$e" +%s 2>/dev/null) || die "bad WINDOW_END: $e"
		[ "$now" -le "$ei" ] || die "engagement window has ended ($e)"
	fi
}

# ---- IPv4 / CIDR helpers ----
is_ipv4() { [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; }
ip2int() { local IFS=. a b c d; read -r a b c d <<<"$1"; echo $(( (a<<24)+(b<<16)+(c<<8)+d )); }
in_cidr() { # <ip> <cidr-or-ip>
	local ip="$1" cidr="$2" net bits ipi neti mask
	net="${cidr%/*}"; bits="${cidr#*/}"; [ "$cidr" = "$net" ] && bits=32
	is_ipv4 "$ip" && is_ipv4 "$net" || return 1
	[[ "$bits" =~ ^[0-9]+$ ]] && [ "$bits" -le 32 ] || return 1
	ipi=$(ip2int "$ip"); neti=$(ip2int "$net")
	if [ "$bits" -eq 0 ]; then mask=0; else mask=$(( (0xFFFFFFFF << (32 - bits)) & 0xFFFFFFFF )); fi
	[ $(( ipi & mask )) -eq $(( neti & mask )) ]
}

# Hard-deny ranges we refuse even if someone mis-scopes them (defensive rail).
# Loopback is NOT here: self-testing 127.0.0.1 is legitimate, but only if explicitly scoped.
hard_denied() { # <ip>
	is_ipv4 "$1" || return 1
	in_cidr "$1" 169.254.0.0/16 && return 0   # link-local incl. cloud metadata 169.254.169.254
	in_cidr "$1" 224.0.0.0/4     && return 0   # multicast
	in_cidr "$1" 0.0.0.0/8       && return 0   # "this network"
	[ "$1" = 255.255.255.255 ]   && return 0   # broadcast
	return 1
}

# Extract a bare host from an IP / host / URL.
target_host() { # <target>
	local t="$1"
	t="${t#*://}"        # strip scheme
	t="${t%%/*}"         # strip path
	t="${t%%:*}"         # strip :port
	printf '%s' "$t"
}

# Is <target> inside the engagement scope and not excluded? Prints reason on refusal.
in_scope() { # <target>
	local host; host="$(target_host "$1")"
	# Exclusions and hard-deny first — they win over any scope entry.
	if hard_denied "$host"; then echo "hard-denied range"; return 1; fi
	local x
	for x in $(eng_list EXCLUDE); do
		if is_ipv4 "$host" && is_ipv4 "${x%/*}"; then
			in_cidr "$host" "$x" && { echo "in EXCLUDE ($x)"; return 1; }
		elif [ "$host" = "$x" ]; then echo "in EXCLUDE ($x)"; return 1; fi
	done
	# IP target: must fall inside a scope CIDR.
	if is_ipv4 "$host"; then
		for x in $(eng_list SCOPE_CIDRS); do in_cidr "$host" "$x" && return 0; done
		echo "not in any SCOPE_CIDRS"; return 1
	fi
	# Hostname target: exact host, or suffix of a scoped domain.
	for x in $(eng_list SCOPE_HOSTS); do [ "$host" = "$x" ] && return 0; done
	for x in $(eng_list SCOPE_DOMAINS); do
		[ "$host" = "$x" ] && return 0
		case "$host" in *".$x") return 0;; esac
	done
	echo "not in SCOPE_HOSTS/SCOPE_DOMAINS"; return 1
}

audit() { # <profile> <image> <dryrun> <cmd> <target...>
	local profile="$1" image="$2" dry="$3" cmd="$4"; shift 4
	local ts op eng ref targets
	ts=$(date -u +%FT%TZ 2>/dev/null || echo "?")
	op="$(eng_get OPERATOR)"; eng="$(eng_get NAME)"; ref="$(eng_get AUTHORIZATION_REF)"
	targets="$*"
	mkdir -p "$(dirname "$AUDIT")" 2>/dev/null
	if have jq; then
		jq -cn --arg ts "$ts" --arg op "$op" --arg eng "$eng" --arg ref "$ref" \
			--arg profile "$profile" --arg targets "$targets" --arg image "$image" \
			--arg dry "$dry" --arg cmd "$cmd" \
			'{ts:$ts,operator:$op,engagement:$eng,authorization_ref:$ref,profile:$profile,
			  targets:($targets|split(" ")),image:$image,dry_run:($dry=="1"),cmd:$cmd}' \
			>> "$AUDIT"
	else
		printf '%s op=%s eng=%s ref=%q profile=%s targets=%q image=%s dry=%s cmd=%q\n' \
			"$ts" "$op" "$eng" "$ref" "$profile" "$targets" "$image" "$dry" "$cmd" >> "$AUDIT"
	fi
}

# ---- profile -> containerized tool command (non-destructive defaults) ----
# Rootless Podman: connect scan (-sT), safe NSE category only, rate-capped. Results to /out.
profile_cmd() { # <profile> <target> <rate>
	local p="$1" t="$2" rate="$3" host; host="$(target_host "$t")"
	case "$p" in
		discovery) echo "nmap -sT -sV -Pn -T3 --max-rate ${rate} --script=safe -oX /out/${host}.nmap.xml ${host}";;
		tls)       echo "sslscan --xml=/out/${host}.sslscan.xml ${host}";;
		web)       echo "sh -c 'whatweb --log-brief=/out/${host}.whatweb.txt ${t}; nuclei -u ${t} -rl ${rate} -severity info,low,medium,high,critical -o /out/${host}.nuclei.txt'";;
		*) return 1;;
	esac
}

container_run() { # <tool-cmd> -> full podman invocation (string)
	# Rootless, all caps dropped, no new privileges, read-only rootfs, results bind-mounted.
	printf 'podman run --rm --network=slirp4netns --cap-drop=ALL --security-opt no-new-privileges=true --read-only --tmpfs /tmp -v %q:/out:Z %q %s' \
		"$RESULTS" "$IMAGE" "$1"
}

# ============================================================ subcommands
cmd_engagement() {
	local sub="${1:-show}"; shift || true
	case "$sub" in
		init)
			local name="${1:?usage: jaa-scan engagement init <name>}"
			[ -e "$ENGAGEMENT" ] && die "$ENGAGEMENT already exists"
			cat > "$ENGAGEMENT" <<EOF
# jaaOS engagement file — AUTHORIZED TESTING ONLY. Parsed as data (not sourced).
# jaa-scan REFUSES to run without AUTHORIZATION_REF and a declared scope.
NAME=$name
AUTHORIZATION_REF=            # REQUIRED: SOW / ticket / written-authorization reference
OPERATOR=$(id -un 2>/dev/null || echo you)
WINDOW_START=                 # optional ISO-8601 UTC, e.g. 2026-11-01T00:00:00Z
WINDOW_END=                   # optional ISO-8601 UTC
SCOPE_CIDRS=                  # space-separated, e.g. 203.0.113.0/24 198.51.100.10/32
SCOPE_HOSTS=                  # space-separated exact hosts, e.g. app.example.com
SCOPE_DOMAINS=                # space-separated; matches the domain and its sub-domains
EXCLUDE=                      # space-separated IPs/CIDRs/hosts to NEVER touch
MAX_RATE_PPS=100              # rate cap passed to the tools
ALLOW_PROFILES=discovery tls web
EOF
			chmod 0600 "$ENGAGEMENT" 2>/dev/null || true
			echo "wrote $ENGAGEMENT — fill in AUTHORIZATION_REF and scope before running."
			;;
		show)     [ -f "$ENGAGEMENT" ] && cat "$ENGAGEMENT" || die "no engagement file ($ENGAGEMENT)";;
		validate) require_engagement; check_window; echo "engagement OK: $(eng_get NAME) (auth: $(eng_get AUTHORIZATION_REF))";;
		*) die "usage: jaa-scan engagement <init|show|validate>";;
	esac
}

cmd_scope() {
	[ "${1:-}" = check ] || die "usage: jaa-scan scope check <target...>"
	shift; require_engagement
	local t reason rc=0
	for t in "$@"; do
		if reason="$(in_scope "$t")"; then echo "IN-SCOPE      $t"; else echo "OUT-OF-SCOPE  $t  ($reason)"; rc=1; fi
	done
	return "$rc"
}

cmd_run() {
	local profile="${1:?usage: jaa-scan run <profile> <target...>}"; shift
	[ "$#" -ge 1 ] || die "no targets given"
	require_engagement
	check_window
	# Profile must be allowed by this engagement.
	local allowed=0 p
	for p in $(eng_list ALLOW_PROFILES); do [ "$p" = "$profile" ] && allowed=1; done
	[ "$allowed" -eq 1 ] || die "profile '$profile' not in ALLOW_PROFILES"
	# ALL targets must be in scope — one out-of-scope target aborts the whole run.
	local t reason
	for t in "$@"; do
		if ! reason="$(in_scope "$t")"; then die "target '$t' $reason — refusing the entire run"; fi
	done
	local rate; rate="$(eng_get MAX_RATE_PPS)"; rate="${rate:-100}"
	mkdir -p "$RESULTS" 2>/dev/null
	echo "engagement : $(eng_get NAME)   auth: $(eng_get AUTHORIZATION_REF)"
	echo "profile    : $profile   rate-cap: ${rate} pps   image: $IMAGE"
	for t in "$@"; do
		local tool full; tool="$(profile_cmd "$profile" "$t" "$rate")" || die "unknown profile '$profile'"
		full="$(container_run "$tool")"
		audit "$profile" "$IMAGE" "$DRYRUN" "$full" "$t"
		if [ "$DRYRUN" = 1 ]; then
			echo "[dry-run] $t"; echo "          $full"
		else
			have podman || die "podman not installed (install the 'security-lab' profile)"
			echo "[run] $t"; eval "$full" || warn "scan of $t exited non-zero"
		fi
	done
	echo "results in $RESULTS ; audit in $AUDIT"
	[ "$DRYRUN" = 1 ] && note "DRY-RUN: nothing was executed or sent over the network."
}

cmd_report() {
	require_engagement
	echo "Engagement: $(eng_get NAME)  (auth: $(eng_get AUTHORIZATION_REF))"
	echo "Results dir: $RESULTS"
	if [ -d "$RESULTS" ]; then
		find "$RESULTS" -maxdepth 1 -type f 2>/dev/null | sort | sed 's/^/  /' || true
	else
		echo "  (no results yet)"
	fi
	echo "Audit log: $AUDIT ($( [ -f "$AUDIT" ] && wc -l < "$AUDIT" | tr -d ' ' || echo 0) run(s) recorded)"
}

usage() {
	cat <<'EOF'
jaa-scan — AUTHORIZED-TESTING-ONLY VAPT orchestrator (scope-enforced, audited)
  engagement init <name>     scaffold an engagement file (fill AUTHORIZATION_REF + scope)
  engagement show|validate   show / validate the active engagement
  scope check <target...>    test targets against scope WITHOUT scanning (the gate, dry)
  run <profile> <target...>  run a profile against in-scope targets (containerized, audited)
  report                     list results + audit summary for the engagement

Profiles (non-destructive): discovery (nmap -sV, safe NSE), tls (sslscan), web (whatweb+nuclei).
Set JAA_SCAN_ENGAGEMENT=<file> to pick an engagement; JAA_SCAN_DRYRUN=1 to resolve
and audit without launching anything. No exploits / DoS / evasion / mass-targeting are provided.
EOF
}

cmd="${1:-help}"; shift || true
case "$cmd" in
	engagement) cmd_engagement "$@";;
	scope)      cmd_scope "$@";;
	run)        cmd_run "$@";;
	report)     cmd_report "$@";;
	help|-h|--help) usage;;
	*) echo "unknown command: $cmd (try 'jaa-scan help')" >&2; exit 2;;
esac
