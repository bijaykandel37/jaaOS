#!/usr/bin/env bash
# Regenerate mobile/apps.lock from the official F-Droid and microG repository indexes.
# Each line pins: set, package, version, URL, SHA-256 of the APK, SHA-256 of its signing
# certificate. `jaa-mobile fetch-apps` refuses any APK that does not match both.
#
#   mobile/tools/update-apps-lock          # then review `git diff mobile/apps.lock`
#
# Trust: indexes are fetched over HTTPS. The microG signer is pinned to microG's repository key
# (the certificate that signs https://microg.org/fdroid/repo/index-v1.jar), not taken from the
# index, so a tampered index cannot swap in a different signer for microG.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
OUT="$ROOT/mobile/apps.lock"
MICROG_SIGNER=9bd06727e62796c0130eb6dab39b73157451582cbd138e86c468acc395d14165
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT

curl -sSfL -o "$tmp/fdroid.json" https://f-droid.org/repo/index-v2.json
curl -sSfL -o "$tmp/microg.jar" https://microg.org/fdroid/repo/index-v1.jar
(cd "$tmp" && unzip -q -o microg.jar index-v1.json)
if command -v keytool >/dev/null 2>&1; then
	got="$(keytool -printcert -jarfile "$tmp/microg.jar" 2>/dev/null | sed -n 's/^[[:space:]]*SHA256: //p' | head -1 | tr -d ':' | tr 'A-F' 'a-f')"
	[ "$got" = "$MICROG_SIGNER" ] || { echo "microG index is not signed by the pinned microG key ($got) — refusing" >&2; exit 1; }
fi

python3 -I - "$tmp/fdroid.json" "$tmp/index-v1.json" "$MICROG_SIGNER" > "$OUT.tmp" <<'PY'
import json, sys
fd = json.load(open(sys.argv[1]))["packages"]
mg = json.load(open(sys.argv[2]))["packages"]
microg_signer = sys.argv[3]
# set | package | what it is
WANT = [
    ("core",     "org.fdroid.fdroid",            "F-Droid — open-source app store"),
    ("core",     "com.aurora.store",             "Aurora Store — Play Store apps without a Google account"),
    ("microg",   "com.google.android.gms",       "microG Services — push notifications, location (optional flavour)"),
    ("microg",   "com.android.vending",          "microG Companion — licensing stub for Play apps (optional flavour)"),
    ("devsec",   "com.termux",                   "Termux — Linux userland: the DevOps/security toolkit runs here"),
    ("devsec",   "com.termux.api",               "Termux:API — notifications/SMS/battery from scripts (alerts)"),
    ("devsec",   "com.termux.boot",              "Termux:Boot — start sshd/services at boot"),
    ("devsec",   "com.termux.widget",            "Termux:Widget — home-screen shortcuts for scripts"),
    ("devsec",   "org.connectbot",               "ConnectBot — standalone SSH client"),
    ("devsec",   "com.gaurav.avnc",              "AVNC — VNC viewer for the Linux desktop"),
    ("devsec",   "com.emanuelef.remote_capture", "PCAPdroid — packet capture without root"),
    ("devsec",   "eu.faircode.netguard",         "NetGuard — per-app firewall without root"),
    ("security", "com.beemdevelopment.aegis",    "Aegis — 2FA codes, encrypted vault"),
    ("security", "com.kunzisoft.keepass.libre",  "KeePassDX — password manager (KeePass)"),
    ("security", "de.nulide.findmydevice",       "FMD — remote locate / lock / wipe via SMS or FMD server"),
    ("security", "me.lucky.wasted",              "Wasted — panic button: lock or wipe on trigger"),
    ("security", "io.heckel.ntfy",               "ntfy — push alerts without Google"),
]
print("# Generated by mobile/tools/update-apps-lock from the official F-Droid and microG indexes. Do not edit.")
print("# set\tpackage\tversion\tversionCode\turl\tsha256\tsigner_sha256\tdescription")
for s, pkg, desc in WANT:
    if pkg in fd:
        v = max(fd[pkg]["versions"].values(), key=lambda v: v["manifest"]["versionCode"])
        m = v["manifest"]; signer = m["signer"]["sha256"][0]
        url = "https://f-droid.org/repo" + v["file"]["name"]
        print("\t".join([s, pkg, m["versionName"], str(m["versionCode"]), url, v["file"]["sha256"], signer, desc]))
    elif pkg in mg:
        v = max(mg[pkg], key=lambda x: x["versionCode"])
        url = "https://microg.org/fdroid/repo/" + v["apkName"]
        print("\t".join([s, pkg, v["versionName"], str(v["versionCode"]), url, v["hash"], microg_signer, desc]))
    else:
        sys.exit("not found in any index: " + pkg)
PY
mv "$OUT.tmp" "$OUT"
echo "wrote $OUT ($(grep -vc '^#' "$OUT") apps)"
