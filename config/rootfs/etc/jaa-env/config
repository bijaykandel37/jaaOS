# jaaOS dual-env configuration. Sourced by jaa-env and jaa-env-pam.
# Set MANAGED_USER to the single user whose home is dual-password managed.
# PROVIDER is "luks2" (isolation; reliable) or "shufflecake" (deniable; beta).
#
# The installer (Phase 3) writes this. Left empty here so an unconfigured system is inert
# (the PAM helper declines for every user until MANAGED_USER is set).
MANAGED_USER=
PROVIDER=luks2

# shufflecake provider only: the whole-disk backing device/file.
# JAA_SC_DEVICE=/dev/disk/by-partlabel/jaa_luks
