# jaaOS interactive bash defaults. Sourced at the END of ~/.bashrc (see build/hooks/10-customize.sh),
# so it wins over the stock Debian settings. Remove that last line from ~/.bashrc to opt out.
case $- in *i*) ;; *) return ;; esac
[ -n "${__JAA_SHELL:-}" ] && return
__JAA_SHELL=1   # not exported: child shells load it again (aliases are not inherited)

# --- key bindings (Tab, Up/Down prefix search, Ctrl+arrows, Alt+S = sudo …) ---
[ -r /etc/jaa/shell/inputrc ] && bind -f /etc/jaa/shell/inputrc

# --- history: large, shared between terminals, no duplicates ---
HISTSIZE=50000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth:erasedups
HISTTIMEFORMAT='%F %T  '
shopt -s histappend cmdhist checkwinsize autocd cdspell dirspell globstar 2>/dev/null
case ";${PROMPT_COMMAND:-};" in *"history -a"*) ;; *) PROMPT_COMMAND="history -a${PROMPT_COMMAND:+; $PROMPT_COMMAND}" ;; esac

# --- completion for commands and their options (git, systemctl, docker, apt, …) ---
if ! declare -F _init_completion >/dev/null && [ -r /usr/share/bash-completion/bash_completion ]; then
	. /usr/share/bash-completion/bash_completion
fi

# --- fzf: Ctrl+R fuzzy history, Ctrl+T insert a file path, Alt+C jump into a directory ---
if command -v fzf >/dev/null 2>&1; then
	eval "$(fzf --bash 2>/dev/null)" || true
fi

# --- Kubernetes (RKE2 ships kubectl, crictl and ctr under /var/lib/rancher/rke2/bin) ---
case ":$PATH:" in *:/var/lib/rancher/rke2/bin:*) ;; *) [ -d /var/lib/rancher/rke2/bin ] && PATH="$PATH:/var/lib/rancher/rke2/bin" ;; esac
if [ "$(id -u)" = 0 ]; then
	[ -z "${KUBECONFIG:-}" ] && [ -r /etc/rancher/rke2/rke2.yaml ] && export KUBECONFIG=/etc/rancher/rke2/rke2.yaml
	export CRI_CONFIG_FILE=/var/lib/rancher/rke2/agent/etc/crictl.yaml
fi
if command -v kubectl >/dev/null 2>&1; then
	# shellcheck disable=SC1090  # generated by kubectl at runtime
	. <(kubectl completion bash 2>/dev/null)
	alias k=kubectl
	complete -o default -F __start_kubectl k 2>/dev/null
	alias kgp='kubectl get pods -A -o wide'
	alias kgn='kubectl get nodes -o wide'
	alias kgs='kubectl get svc -A'
	alias kd='kubectl describe'
	alias kl='kubectl logs -f'
	alias kex='kubectl exec -it'
fi

# --- Docker ---
alias dps='docker ps --format "table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}"'
alias dpa='docker ps -a'
alias di='docker images'
alias dl='docker logs -f'
alias dex='docker exec -it'
alias dc='docker compose'

# --- everyday ---
alias ls='ls --color=auto'
alias ll='ls -alFh --color=auto'
alias la='ls -A --color=auto'
alias grep='grep --color=auto'
alias ..='cd ..'
alias ...='cd ../..'
alias ports='ss -tulpn'
alias myip='ip -4 -br addr show scope global'
alias please='sudo $(fc -ln -1)'

# --- prompt: [master]/[worker] tag, red user for root, green otherwise ---
__jaa_role="$(sed -n 's/^ROLE=//p' /etc/jaa/cluster.conf 2>/dev/null)"
case "$__jaa_role" in server) __jaa_tag='[master] ' ;; agent) __jaa_tag='[worker] ' ;; *) __jaa_tag='' ;; esac
if [ "$(id -u)" = 0 ]; then __jaa_ucol='1;31'; else __jaa_ucol='1;32'; fi
PS1="\[\e[1;33m\]${__jaa_tag}\[\e[${__jaa_ucol}m\]\u@\h\[\e[0m\]:\[\e[1;34m\]\w\[\e[0m\]\\$ "
unset __jaa_role __jaa_tag __jaa_ucol
