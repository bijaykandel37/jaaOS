{
  "uid": "jaa-security",
  "title": "jaaOS — Security & Integrity",
  "tags": ["jaaos", "security"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "auditd",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "jaa-prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "up", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "targets": [ { "refId": "A", "expr": "jaa_auditd_up" } ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "AIDE changes (last check)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "jaa-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "orange", "value": 1 }
          ] }
        },
        "overrides": []
      },
      "targets": [ { "refId": "A", "expr": "jaa_aide_changes_total" } ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Hours since AIDE check",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "jaa-prometheus" },
      "fieldConfig": { "defaults": { "unit": "h" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "(time() - jaa_aide_last_run_timestamp_seconds) / 3600" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "AppArmor profiles (enforce)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "jaa-prometheus" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "jaa_apparmor_profiles{mode=\"enforce\"}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Falco events (rate/15m)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "jaa-prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "increase(jaa_falco_events_total[15m])", "legendFormat": "falco events" }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Recent warnings/errors (journal via Loki)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "jaa-loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "dedupStrategy": "none", "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "expr": "{job=\"systemd-journal\"} | level=~\"error|warning|crit|alert|emerg\"" }
      ]
    }
  ]
}
