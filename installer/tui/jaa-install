#!/usr/bin/env bash
# jaaOS installer (TUI + unattended). Orchestration only (ADR 0002): it drives sgdisk,
# cryptsetup, mmdebstrap, ukify, etc. onto a TARGET DISK.
#
#   sudo jaa-install                              # interactive (whiptail)
#   sudo jaa-install --unattended answers.conf    # scripted (CI / reinstalls)
#
# DESTRUCTIVE: it repartitions the chosen disk. By design it creates only the DECLARABLE
# home environment when dual-env is enabled; add hidden environments later with `jaa-env
# add`. See docs/04-phase3-installer.md.
set -euo pipefail

# ---------------------------------------------------------------- data + helpers
SELF="$(readlink -f "$0")"
SELF_DIR="$(dirname "$SELF")"
# Installer data (config/rootfs, hooks, profiles). Dev tree first, then installed location.
if [ -d "$SELF_DIR/../../config/rootfs" ]; then
	DATA="$(readlink -f "$SELF_DIR/../..")"
elif [ -d /usr/share/jaaos/config/rootfs ]; then
	DATA=/usr/share/jaaos
else
	echo "cannot locate installer data (config/rootfs, build/profiles)" >&2; exit 1
fi

SUITE="${SUITE:-trixie}"
SNAPSHOT="${SNAPSHOT:-20261001T000000Z}"
COMPONENTS="main contrib non-free-firmware"
MIRROR="${MIRROR:-https://snapshot.debian.org/archive/debian/${SNAPSHOT}}"
SECMIRROR="${SECMIRROR:-https://snapshot.debian.org/archive/debian-security/${SNAPSHOT}}"
JC="$DATA/packages/jaa-cluster/bin/jaa-cluster"
MAPPER=jaa_root
MOUNTOPTS="compress=zstd:1,noatime,space_cache=v2"
LUKS_ARGS=(--type luks2 --pbkdf argon2id --pbkdf-memory 1048576 --pbkdf-force-iterations 4
           --cipher aes-xts-plain64 --key-size 512 --hash sha512 --batch-mode)

die() { echo "ERROR: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
part() { case "$1" in *[0-9]) echo "${1}p${2}";; *) echo "${1}${2}";; esac; }
# One package per line -> comma list. Strip whitespace WITHIN lines only: deleting newlines
# (tr -d '[:space:]') would glue every name into one invalid token.
pkglist() { sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' "$@" | paste -sd, -; }
mac4() {
	local n
	for n in /sys/class/net/*; do
		case "${n##*/}" in lo|docker*|br-*|cni*|flannel*|cali*|veth*|virbr*) continue;; esac
		[ -r "$n/address" ] && { tr -d ':\n' < "$n/address" | tail -c 4; return; }
	done
	echo 0000
}
fp4() { printf '%s' "$1" | cut -c1-16 | sed 's/..../& /g; s/ $//'; }

[ "$(id -u)" -eq 0 ] || die "run as root"
# jaaOS requires UEFI on real hardware. JAA_ALLOW_NO_UEFI=1 relaxes this for the
# loopback install test on a non-UEFI build host (tests/vm/install-test.sh).
[ -d /sys/firmware/efi ] || [ "${JAA_ALLOW_NO_UEFI:-}" = 1 ] || die "not booted in UEFI mode (jaaOS requires UEFI)"
for t in sgdisk cryptsetup mkfs.btrfs btrfs mkfs.vfat mmdebstrap blkid; do
	have "$t" || die "missing required tool: $t (install the installer dependencies)"
done

# ---------------------------------------------------------------- gather answers
UNATTENDED=""
[ "${1:-}" = "--unattended" ] && { UNATTENDED="${2:-}"; [ -r "$UNATTENDED" ] || die "answer file not readable: $UNATTENDED"; }

if [ -n "$UNATTENDED" ]; then
	# shellcheck disable=SC1090
	. "$UNATTENDED"
else
	have whiptail || die "whiptail not installed and no --unattended file given"
	# Disk menu from lsblk (whole disks only)
	mapfile -t DISKS < <(lsblk -dnpo NAME,SIZE,MODEL -e 7,11 | awk '{print $1" "$2" "substr($0, index($0,$3))}')
	[ "${#DISKS[@]}" -gt 0 ] || die "no disks found"
	menu=(); for d in "${DISKS[@]}"; do menu+=("$(echo "$d" | awk '{print $1}')" "$(echo "$d" | cut -d' ' -f2-)"); done
	TARGET_DISK="$(whiptail --title "jaaOS installer" --menu "Select the target disk (ALL DATA WILL BE ERASED)" 20 70 10 "${menu[@]}" 3>&1 1>&2 2>&3)" || exit 1
	PROFILE="$(whiptail --title "Profile" --menu "Install profile" 17 64 5 \
		minimal "Base + SSH + firewall (no GUI)" \
		server "Minimal + containers + monitoring base" \
		desktop-xfce "XFCE desktop (light, X11) - like the live ISO" \
		desktop "GNOME desktop (Wayland, heavier)" \
		security-lab "Desktop + VAPT container tooling" 3>&1 1>&2 2>&3)" || exit 1
	CLUSTER_ROLE="$(whiptail --title "Kubernetes (RKE2)" --menu "What is this machine in a Kubernetes cluster?\nDocker is installed in every case." 15 74 3 \
		none   "Not part of a cluster" \
		master "Master: the control plane of a new cluster" \
		worker "Worker: join an existing master" 3>&1 1>&2 2>&3)" || exit 1
	if [ "$CLUSTER_ROLE" = worker ]; then
		whiptail --infobox "Looking for jaaOS masters on this network (6 s)..." 7 56
		mapfile -t FOUND < <(bash "$JC" discover --seconds 6 2>/dev/null || true)
		menu=()
		for f in "${FOUND[@]}"; do
			IFS=$'\t' read -r m_name m_ip m_port m_fp <<<"$f"
			menu+=("$m_ip:$m_port" "$m_name   fingerprint $(fp4 "$m_fp")")
		done
		menu+=(manual "Type the master's address")
		CLUSTER_SERVER="$(whiptail --title "Master" --menu "Masters announcing on this network (on the master: sudo jaa-cluster announce):" 18 76 8 "${menu[@]}" 3>&1 1>&2 2>&3)" || exit 1
		if [ "$CLUSTER_SERVER" = manual ]; then
			CLUSTER_SERVER="$(whiptail --inputbox "Master IP address or hostname" 8 60 3>&1 1>&2 2>&3)" || exit 1
		fi
		CLUSTER_JOIN_CODE="$(whiptail --inputbox "Join code (on the master: sudo jaa-cluster join-code)\nIt looks like: abcdef.0123456789abcdef" 10 66 3>&1 1>&2 2>&3)" || exit 1
		m_hash="$(bash "$JC" fingerprint "$CLUSTER_SERVER")" || die "no RKE2 master answering at $CLUSTER_SERVER"
		whiptail --title "Check the master" --yesno "Master fingerprint:\n\n      $(fp4 "$m_hash")\n\nDoes it match the fingerprint 'jaa-cluster join-code' printed on the master?\nIf not, choose No: something else is answering at that address." 14 70 \
			|| die "fingerprint not confirmed — not joining"
		CLUSTER_FINGERPRINT="$m_hash"
	fi
	case "$CLUSTER_ROLE" in master|worker) def_host="jaa-$CLUSTER_ROLE-$(mac4)";; *) def_host=jaa;; esac
	HOSTNAME="$(whiptail --inputbox "Hostname (every cluster node needs a unique one)" 8 60 "$def_host" 3>&1 1>&2 2>&3)" || exit 1
	USERNAME="$(whiptail --inputbox "Username" 8 50 admin 3>&1 1>&2 2>&3)" || exit 1
	USER_PW="$(whiptail --passwordbox "Login password (unlocks your home environment)" 8 60 3>&1 1>&2 2>&3)" || exit 1
	FDE_PW="$(whiptail --passwordbox "Disk-encryption passphrase (asked at boot)" 8 60 3>&1 1>&2 2>&3)" || exit 1
	if whiptail --yesno "Enable dual-password home (deniable second environment, added later with 'jaa-env add')?" 9 70; then DUAL_ENV=yes; else DUAL_ENV=no; fi
	if whiptail --yesno "Enroll TPM2 for boot unlock (with a PIN)?" 8 60; then TPM2=yes; else TPM2=no; fi
	TPM2_PIN=""
	[ "$TPM2" = yes ] && TPM2_PIN="$(whiptail --passwordbox "TPM2 PIN" 8 50 3>&1 1>&2 2>&3)" || true
fi

: "${TARGET_DISK:?}"; : "${PROFILE:?}"; : "${HOSTNAME:?}"; : "${USERNAME:?}"
: "${USER_PW:?}"; : "${FDE_PW:?}"; : "${DUAL_ENV:=no}"; : "${TPM2:=no}"; : "${TPM2_PIN:=}"
: "${CLUSTER_ROLE:=none}"; : "${CLUSTER_SERVER:=}"; : "${CLUSTER_JOIN_CODE:=}"; : "${CLUSTER_FINGERPRINT:=}"; : "${CLUSTER_TOKEN:=}"
case "$CLUSTER_ROLE" in none|master|worker) ;; *) die "CLUSTER_ROLE must be none, master or worker";; esac
if [ "$CLUSTER_ROLE" != none ]; then
	HOSTNAME="${HOSTNAME,,}"   # Kubernetes node names are lowercase
	[[ "$HOSTNAME" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] || die "cluster node hostname must be letters, digits and '-' (got: $HOSTNAME)"
fi
if [ "$CLUSTER_ROLE" = worker ]; then
	[ -n "$CLUSTER_SERVER" ] || die "a worker needs CLUSTER_SERVER (the master's address)"
	if [ -z "$CLUSTER_TOKEN" ]; then
		[ -n "$CLUSTER_JOIN_CODE" ] || die "a worker needs CLUSTER_JOIN_CODE (sudo jaa-cluster join-code on the master)"
		fp="$(printf '%s' "$CLUSTER_FINGERPRINT" | tr -d ' :' | tr 'A-F' 'a-f')"
		[ "${#fp}" -ge 16 ] || die "CLUSTER_FINGERPRINT must hold at least the 16 hex digits jaa-cluster join-code prints"
		m_hash="$(bash "$JC" fingerprint "$CLUSTER_SERVER")" || die "no RKE2 master answering at $CLUSTER_SERVER"
		[[ "$m_hash" == "$fp"* ]] || die "master fingerprint $(fp4 "$m_hash") does not match CLUSTER_FINGERPRINT — refusing"
		CLUSTER_TOKEN="K10${m_hash}::${CLUSTER_JOIN_CODE}"
	fi
fi
[ -b "$TARGET_DISK" ] || die "not a block device: $TARGET_DISK"
[ -f "$DATA/build/profiles/${PROFILE}.packages" ] || [ "$PROFILE" = minimal ] || die "unknown profile: $PROFILE"

# Final destructive confirmation (even unattended requires CONFIRM_WIPE=yes)
if [ -n "$UNATTENDED" ]; then
	[ "${CONFIRM_WIPE:-}" = yes ] || die "set CONFIRM_WIPE=yes in the answer file to proceed"
else
	ans="$(whiptail --inputbox "Type ERASE to wipe $TARGET_DISK and install jaaOS" 9 60 3>&1 1>&2 2>&3)" || exit 1
	[ "$ans" = ERASE ] || die "not confirmed"
fi

ESP_DEV="$(part "$TARGET_DISK" 1)"
LUKS_DEV="$(part "$TARGET_DISK" 2)"
MNT="$(mktemp -d)"
cleanup() {
	set +e
	for m in run sys proc dev/pts dev boot/efi; do mountpoint -q "$MNT/$m" && umount -l "$MNT/$m"; done
	mountpoint -q "$MNT" && umount -R "$MNT"
	[ -e "/dev/mapper/$MAPPER" ] && cryptsetup close "$MAPPER"
	rmdir "$MNT" 2>/dev/null || true
}
trap cleanup EXIT

# ---------------------------------------------------------------- partition + crypto + fs
echo "==> Partitioning $TARGET_DISK"
wipefs -a "$TARGET_DISK" >/dev/null 2>&1 || true
sgdisk --zap-all "$TARGET_DISK" >/dev/null
sgdisk -n1:0:+512M -t1:ef00 -c1:ESP "$TARGET_DISK" >/dev/null
sgdisk -n2:0:0     -t2:8309 -c2:jaa_luks "$TARGET_DISK" >/dev/null
partprobe "$TARGET_DISK" 2>/dev/null || udevadm settle || sleep 1

echo "==> ESP + LUKS2"
mkfs.vfat -F32 -n ESP "$ESP_DEV" >/dev/null
printf '%s' "$FDE_PW" | cryptsetup luksFormat "${LUKS_ARGS[@]}" "$LUKS_DEV" -
printf '%s' "$FDE_PW" | cryptsetup open "$LUKS_DEV" "$MAPPER" -

echo "==> Btrfs subvolumes"
mkfs.btrfs -L jaa -f "/dev/mapper/$MAPPER" >/dev/null
mount "/dev/mapper/$MAPPER" "$MNT"
for sv in @ @home @snapshots @var @log; do btrfs subvolume create "$MNT/$sv" >/dev/null; done
umount "$MNT"
mount -o "subvol=@,$MOUNTOPTS" "/dev/mapper/$MAPPER" "$MNT"
mkdir -p "$MNT"/{home,.snapshots,var,boot/efi}
mount -o "subvol=@home,$MOUNTOPTS"      "/dev/mapper/$MAPPER" "$MNT/home"
mount -o "subvol=@snapshots,$MOUNTOPTS" "/dev/mapper/$MAPPER" "$MNT/.snapshots"
mount -o "subvol=@var,$MOUNTOPTS"       "/dev/mapper/$MAPPER" "$MNT/var"
mkdir -p "$MNT/var/log"; mount -o "subvol=@log,$MOUNTOPTS" "/dev/mapper/$MAPPER" "$MNT/var/log"
mount "$ESP_DEV" "$MNT/boot/efi"

# ---------------------------------------------------------------- base system
echo "==> Installing base system (mmdebstrap) — this downloads packages"
# Every profile = minimal + cluster (Docker, mDNS, shell tools) + the profile's extras.
PROFILE_FILES=("$DATA/build/profiles/minimal.packages" "$DATA/build/profiles/cluster.packages")
if [ "$PROFILE" != minimal ] && [ -f "$DATA/build/profiles/${PROFILE}.packages" ]; then
	PROFILE_FILES+=("$DATA/build/profiles/${PROFILE}.packages")
	# Security Lab builds on top of Desktop.
	[ "$PROFILE" = security-lab ] && PROFILE_FILES+=("$DATA/build/profiles/desktop.packages")
fi
PKGS="$(pkglist "${PROFILE_FILES[@]}")"
mmdebstrap --variant=minbase --architectures=amd64 --components="$COMPONENTS" \
	--include="$PKGS" --aptopt='Acquire::Check-Valid-Until "false";' \
	--customize-hook="sync-in '$DATA/config/rootfs' /" \
	--customize-hook="copy-in '$DATA/build/hooks/10-customize.sh' /tmp/" \
	--customize-hook="chroot \$1 bash /tmp/10-customize.sh" \
	--customize-hook="chroot \$1 rm -f /tmp/10-customize.sh" \
	"$SUITE" "$MNT" \
	"deb ${MIRROR} ${SUITE} ${COMPONENTS}" \
	"deb ${SECMIRROR} ${SUITE}-security ${COMPONENTS}"

# ---------------------------------------------------------------- crypttab / fstab / cmdline
LUKS_UUID="$(blkid -s UUID -o value "$LUKS_DEV")"
ESP_UUID="$(blkid -s UUID -o value "$ESP_DEV")"
printf '%s UUID=%s none luks,discard\n' "$MAPPER" "$LUKS_UUID" > "$MNT/etc/crypttab"
cat > "$MNT/etc/fstab" <<EOF
/dev/mapper/$MAPPER /           btrfs subvol=@,$MOUNTOPTS 0 0
/dev/mapper/$MAPPER /home       btrfs subvol=@home,$MOUNTOPTS 0 0
/dev/mapper/$MAPPER /.snapshots btrfs subvol=@snapshots,$MOUNTOPTS 0 0
/dev/mapper/$MAPPER /var        btrfs subvol=@var,$MOUNTOPTS 0 0
/dev/mapper/$MAPPER /var/log    btrfs subvol=@log,$MOUNTOPTS 0 0
UUID=$ESP_UUID /boot/efi vfat umask=0077,shortname=winnt 0 2
tmpfs /tmp     tmpfs rw,nosuid,nodev,noexec,size=2G 0 0
tmpfs /var/tmp tmpfs rw,nosuid,nodev,noexec,size=1G 0 0
EOF
install -d "$MNT/etc/kernel"
grep -vE '^[[:space:]]*#' "$DATA/kernel/cmdline" | tr -d '\n' | sed 's/[[:space:]]\+/ /g; s/^ //; s/ $//' > "$MNT/etc/kernel/cmdline"
echo >> "$MNT/etc/kernel/cmdline"

# ---------------------------------------------------------------- chroot: boot, user, dual-env
mount --bind /dev "$MNT/dev"; mount --bind /dev/pts "$MNT/dev/pts"
mount -t proc proc "$MNT/proc"; mount -t sysfs sysfs "$MNT/sys"; mount -t tmpfs tmpfs "$MNT/run"

echo "==> Configuring the installed system"
chroot "$MNT" /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root DEBIAN_FRONTEND=noninteractive \
	HOSTNAME="$HOSTNAME" USERNAME="$USERNAME" USER_PW="$USER_PW" DUAL_ENV="$DUAL_ENV" \
	/bin/bash -euo pipefail <<'CHROOT'
KVER="$(ls -1 /boot/vmlinuz-* | sort -V | tail -n1)"; KVER="${KVER#/boot/vmlinuz-}"
echo "$HOSTNAME" > /etc/hostname
sed -i "s/^127\.0\.1\.1.*/127.0.1.1\t$HOSTNAME/" /etc/hosts

# Secure Boot keys owned by this machine; sign the UKI + bootloader.
KEYS=/var/lib/jaaos/secureboot; mkdir -p "$KEYS"
if [ ! -f "$KEYS/db.key" ]; then
	openssl req -new -x509 -newkey rsa:4096 -sha256 -days 3650 -nodes \
		-subj "/CN=jaaOS db $(hostname)/" -keyout "$KEYS/db.key" -out "$KEYS/db.crt"
	chmod 600 "$KEYS/db.key"
fi

update-initramfs -u -k "$KVER"
bootctl install --esp-path=/boot/efi --no-variables
cat > /boot/efi/loader/loader.conf <<LOADER
default jaaos-*.efi
timeout 3
console-mode auto
editor no
LOADER
mkdir -p /boot/efi/EFI/Linux
ukify build --linux="/boot/vmlinuz-$KVER" --initrd="/boot/initrd.img-$KVER" \
	--cmdline=@/etc/kernel/cmdline --os-release=@/etc/os-release \
	--signtool=sbsign --secureboot-private-key="$KEYS/db.key" --secureboot-certificate="$KEYS/db.crt" \
	--output="/boot/efi/EFI/Linux/jaaos-$KVER.efi"
for f in /boot/efi/EFI/systemd/systemd-bootx64.efi /boot/efi/EFI/BOOT/BOOTX64.EFI; do
	[ -f "$f" ] && sbsign --key "$KEYS/db.key" --cert "$KEYS/db.crt" --output "$f" "$f"
done

# snapper for /
install -Dm644 /usr/share/snapper/config-templates/default /etc/snapper/configs/root
sed -i 's#^SUBVOLUME=.*#SUBVOLUME="/"#; s#^TIMELINE_CREATE=.*#TIMELINE_CREATE="no"#' /etc/snapper/configs/root
printf 'SNAPPER_CONFIGS="root"\n' > /etc/default/snapper

# user
id "$USERNAME" >/dev/null 2>&1 || useradd --create-home --shell /bin/bash --groups sudo "$USERNAME"
if [ "$DUAL_ENV" = yes ]; then
	# Login password protects the (separate) home container; lock the shadow field so no hash
	# can reveal a password. The jaa-env PAM flow authenticates against the container.
	passwd -l "$USERNAME" >/dev/null
else
	echo "$USERNAME:$USER_PW" | chpasswd
fi
echo "bootloader + user configured for $KVER"
CHROOT

# ---------------------------------------------------------------- Docker + RKE2 role
RKE2_VER="$(sed -n 's/^RKE2_VERSION=//p' "$DATA/build/rke2.lock")"
echo "==> RKE2 $RKE2_VER (role: $CLUSTER_ROLE)"
if [ -x /usr/local/bin/rke2 ] && [ -f /usr/local/lib/systemd/system/rke2-server.service ]; then
	# Booted from the jaaOS ISO: copy the RKE2 that ships on it (no download).
	tar -C /usr/local -cf - bin/rke2 bin/rke2-killall.sh bin/rke2-uninstall.sh \
		lib/systemd/system/rke2-server.service lib/systemd/system/rke2-server.env \
		lib/systemd/system/rke2-agent.service lib/systemd/system/rke2-agent.env share/rke2 \
		| tar -C "$MNT/usr/local" -xf -
else
	RKE2_DIR="$(bash "$DATA/build/fetch-rke2.sh" | tail -1)"
	tar -C "$MNT/usr/local" -xzf "$RKE2_DIR/rke2.linux-amd64.tar.gz"
fi
install -Dm755 "$JC" "$MNT/usr/bin/jaa-cluster"
JC_ARGS=(setup "$CLUSTER_ROLE" --root "$MNT")
[ "$CLUSTER_ROLE" != none ] && JC_ARGS+=(--name "$HOSTNAME")
[ "$CLUSTER_ROLE" = worker ] && JC_ARGS+=(--server "$CLUSTER_SERVER" --token "$CLUSTER_TOKEN")
bash "$JC" "${JC_ARGS[@]}"

# ---------------------------------------------------------------- dual-env (declarable only)
if [ "$DUAL_ENV" = yes ]; then
	echo "==> Setting up the declarable home environment (hidden envs are added later)"
	install -d "$MNT/etc/jaa-env"
	printf 'MANAGED_USER=%s\nPROVIDER=luks2\n' "$USERNAME" > "$MNT/etc/jaa-env/config"
	# Install the jaa-env tooling into the target (dev tree -> target paths).
	install -Dm755 "$DATA/packages/jaa-env/bin/jaa-env"     "$MNT/usr/bin/jaa-env"
	install -Dm755 "$DATA/packages/jaa-env/bin/jaa-env-pam" "$MNT/usr/lib/jaa-env/bin/jaa-env-pam"
	install -Dm755 "$DATA/packages/jaa-env/providers/luks2"      "$MNT/usr/lib/jaa-env/providers/luks2"
	install -Dm755 "$DATA/packages/jaa-env/providers/shufflecake" "$MNT/usr/lib/jaa-env/providers/shufflecake"
	# Create the primary (decoy) environment with the login password.
	chroot "$MNT" /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin \
		JAA_USER="$USERNAME" /usr/lib/jaa-env/providers/luks2 init <<<"$USER_PW"
	echo "   NOTE: wire /usr/lib/jaa-env/bin/jaa-env-pam into PAM services"
	echo "         (login, sshd, gdm-password, sudo, su, polkit-1) per packages/jaa-env/pam/."
fi

# ---------------------------------------------------------------- TPM2 (real hardware only)
if [ "$TPM2" = yes ]; then
	echo "==> Enrolling TPM2 for boot unlock"
	if [ -c /dev/tpmrm0 ] || [ -c /dev/tpm0 ]; then
		if [ -n "$TPM2_PIN" ]; then
			printf '%s\n%s\n' "$FDE_PW" "$TPM2_PIN" | systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs=7 --tpm2-with-pin=yes "$LUKS_DEV" || echo "   TPM2 enroll failed; passphrase still works."
		else
			printf '%s\n' "$FDE_PW" | systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs=7 "$LUKS_DEV" || echo "   TPM2 enroll failed; passphrase still works."
		fi
	else
		echo "   No TPM device present; skipping (passphrase unlock remains)."
	fi
fi

echo
echo "jaaOS install complete on $TARGET_DISK."
echo "Enroll your Secure Boot keys (/var/lib/jaaos/secureboot/db.crt) via firmware Setup Mode,"
echo "then reboot. Add a hidden environment later with:  sudo jaa-env add"
case "$CLUSTER_ROLE" in
	master) echo "Kubernetes: this is a MASTER. After it boots:  sudo jaa-cluster join-code  and  sudo jaa-cluster announce";;
	worker) echo "Kubernetes: this WORKER joins $CLUSTER_SERVER on first boot (check: sudo jaa-cluster status)";;
	*)      echo "Kubernetes: none (Docker only). Change later with:  sudo jaa-cluster setup master|worker";;
esac
